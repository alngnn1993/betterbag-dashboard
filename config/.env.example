# Finn AI CEO System - Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# SERVER CONFIG
# ============================================
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# SUPABASE CONFIG
# ============================================
SUPABASE_URL=https://waghkocfgqjdpfpfqmre.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndhZ2hrb2NmZ3FqZHBmcGZxbXJlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzYxMjE4OTMsImV4cCI6MjA5MTY5Nzg5M30.oqKNcguGfEar_WFlWBagapMp7_x3XK8Sgw6BcBgDtwI
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# CLAUDE API CONFIG
# ============================================
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-opus-4-20250514
CLAUDE_MAX_TOKENS=2048

# ============================================
# PINECONE CONFIG (Vector Database)
# ============================================
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=us-east-1-aws
PINECONE_INDEX=finn-knowledge

# ============================================
# ENCRYPTION CONFIG
# ============================================
ENCRYPTION_KEY=your_encryption_key_here
JWT_SECRET=your_jwt_secret_here
HASH_ROUNDS=10

# ============================================
# DATABASE CONFIG
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/finn_db
DATABASE_SSL=true

# ============================================
# SECURITY CONFIG
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_IP_WHITELIST=false
IP_WHITELIST=127.0.0.1

# ============================================
# BACKUP & STORAGE CONFIG
# ============================================
AWS_ACCESS_KEY_ID=your_aws_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=finn-backups
BACKUP_FREQUENCY=daily

# ============================================
# MONITORING CONFIG
# ============================================
ENABLE_MONITORING=true
MONITORING_INTERVAL=5m
ALERT_EMAIL=your_email@example.com
SLACK_WEBHOOK_URL=your_slack_webhook_url

# ============================================
# DEVELOPMENT CONFIG
# ============================================
DEBUG=false
VERBOSE_LOGGING=false
